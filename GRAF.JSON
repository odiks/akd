    {"id": 24, "type": "timeseries", "title": "New alerts per rule (time fired)", "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8}, "datasource": {"type": "elasticsearch", "uid": "es-kibana-alerts"}, "targets": [{"refId": "A", "datasource": {"type": "elasticsearch", "uid": "es-kibana-alerts"}, "query": "kibana.alert.rule.tags:(logstash OR linux) AND NOT kibana.alert.status:untracked", "metrics": [{"id": "1", "type": "count"}], "bucketAggs": [{"id": "3", "type": "terms", "field": "kibana.alert.rule.name", "settings": {"size": "10", "order": "desc", "orderBy": "_count", "min_doc_count": "1"}}, {"id": "2", "type": "date_histogram", "field": "kibana.alert.start", "settings": {"interval": "auto", "min_doc_count": "0"}}], "timeField": "@timestamp"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "min": 0, "custom": {"drawStyle": "bars", "fillOpacity": 80, "stacking": {"mode": "normal", "group": "A"}, "lineWidth": 1, "showPoints": "never"}}, "overrides": []}, "description": "Kibana alerts of the Logstash and Linux rules (.alerts-* index, rules tagged logstash or linux)."},
